# Copie ce fichier en ".env" à la racine du projet (là où sont /frontend et /backend)
# et remplis les valeurs. Le ".env" ne doit JAMAIS être commité (ajoute-le au .gitignore).

# --- Destinataire ---
REPORT_TO=journalier.stage@gmail.com

# --- Envoi SMTP (exemple avec un compte Gmail) ---
# Utilise un "mot de passe d'application" Gmail, pas ton mot de passe normal :
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.adresse@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=ton.adresse@gmail.com

# --- Heure cible d'envoi automatique ---
SEND_HOUR=19
SEND_MINUTE=0
# Si tu prépares le rapport APRÈS l'heure cible (soirée/nuit), il part ce nombre
# de minutes après la préparation plutôt que d'attendre le lendemain 19h.
GRACE_MINUTES=10

# --- Génération IA du rapport (Groq, gratuit) ---
# Clé à récupérer sur https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# --- Dump base de données (optionnel, laisse vide tant que la base n'existe pas) ---
DATABASE_URL=postgresql://user:password@localhost:5432/awen
