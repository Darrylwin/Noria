# Optionnel. Chaque valeur ci-dessous a déjà un défaut de développement local
# codé dans backend/docker-compose.yml et frontend/docker-compose.yml.
# Créer un .env réel à ce niveau uniquement pour surcharger ces défauts
# (typiquement en déploiement, si frontend et backend ne sont pas sur localhost).

FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001