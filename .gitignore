# Monorepo root .gitignore
# Chaque application (backend/, frontend/) possède son propre .gitignore
# pour ses artefacts spécifiques (node_modules, dist, .next, etc.).
# Celui-ci couvre uniquement ce qui est commun ou propre à la racine du dépôt.

# IDE / éditeurs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
.project
.classpath
.c9/
*.launch
.settings/

# OS
.DS_Store
Thumbs.db
*.pem

# Variables d'environnement - jamais commitées, à la racine comme dans chaque app
.env
.env.local
.env.*.local

# Node (au cas où des dépendances seraient installées à la racine)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Docker - volumes et données locales générés par docker-compose à la racine
docker-compose.override.yml
.docker/

# Logs
logs/
*.log

# Runtime / diagnostics
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Couverture de tests, si jamais agrégée à la racine
/coverage

# Divers
*.tsbuildinfo